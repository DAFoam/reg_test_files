FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=128";
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    mixture         pureMixture;
    specie          specie;
    equationOfState perfectGas;
    energy          sensibleInternalEnergy;
    thermo          hConst;
    type            hePsiThermo;
    transport       const;
}

mixture
{
    specie
    {
        molWeight       28.97;
    }
    thermodynamics
    {
        Cp              1005;
        Hf              0;
    }
    transport
    {
        mu              4.723119573527436e-05;
        Pr              0.7;
        TRef            300;
    }
}


